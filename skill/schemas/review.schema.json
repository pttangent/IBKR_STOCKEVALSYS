{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adversarial Claim Review",
  "type": "object",
  "required": ["run_id", "reviewer", "claim_reviews", "scenario_probability_deltas", "evidence_requests"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "reviewer": {"enum": ["bull", "bear", "skeptic"]},
    "claim_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "assessment", "reason", "evidence_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "assessment": {"enum": ["strengthen", "weaken", "invalidate", "unchanged", "unresolved"]},
          "reason": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence_delta": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "scenario_probability_deltas": {
      "type": "object",
      "properties": {
        "bull": {"type": "number"},
        "base": {"type": "number"},
        "bear": {"type": "number"},
        "unknown": {"type": "number"},
        "event": {"type": "number"}
      },
      "additionalProperties": false
    },
    "evidence_requests": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
