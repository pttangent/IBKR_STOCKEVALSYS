{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockEval Evidence Packet",
  "type": "object",
  "required": ["schema_version", "symbol", "as_of", "evidence_freeze_hash", "sources", "source_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "symbol": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 10},
    "evidence_freeze_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "source_id", "provider", "source_type", "retrieved_at", "reliability", "data"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "source_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "as_of": {"type": ["string", "null"]},
          "available_at": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string"},
          "reliability": {"type": "string"},
          "source_url": {"type": ["string", "null"]},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"},
          "data": {}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "missing_evidence_requests": {"type": "array"}
  }
}
