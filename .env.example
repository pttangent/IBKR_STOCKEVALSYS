# Vendored MCP HTTP/streaming server.
SERVER_HOST="127.0.0.1"
SERVER_PORT="8765"

# The MCP connection tool uses these defaults when parameters are omitted.
TWS_HOST="127.0.0.1"
TWS_PORT="7497"
TWS_CLIENT_ID="91"
TWS_PAPER_ACCOUNT=""
